</div>
<div class="carousel-item">
<img alt="Presentazione del progetto" loading="lazy" src="/polis2smartcity/polis2smartcity/polis2smartcity/polis2smartcity/images/IOT5.jpeg"/>
<div class="item-caption" data-en="Final check and integration" data-it="Verifica finale e integrazione">Verifica finale e integrazione</div>
</div>
</div>
</div>
</section>
</main>

---
import { gallery } from '../data/site';
import { i } from '../data/i18n';
---
<section class="gallery" id="galleria">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <div class="section-tag" {...i('La città in immagini', 'Gallery')}>La città in immagini</div>
        <h2 {...i('Foto', 'Photos')}>foto</h2>
      </div>
      <p class="desc">foto</p>
    </div>
    <div class="gal-grid">
      {gallery.map((g) => (
        <div class="gal-item reveal">
          <img src={g.src} alt={g.alt} loading="lazy" />
          <div class="gal-cap" {...(g.cap.en ? i(g.cap.it, g.cap.en) : {})}>{g.cap.it}</div>
        </div>
      ))}
    </div>
  </div>
</section>
---
import { resources } from '../data/site';
import { i } from '../data/i18n';
---
<section class="compare" id="confronto">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <div class="section-tag" {...i('Risorse', 'Resources')}>Risorse</div>
        <h2>...</h2>
      </div>
      <p class="desc">...</p>
    </div>
    <div class="reveal">
      <div class="cmp-head"><div>...</div><div>...</div></div>
      {resources.map(([a, b]) => <div class="cmp-row"><div>{a}</div><div>{b}</div></div>)}
    </div>
  </div>
</section>
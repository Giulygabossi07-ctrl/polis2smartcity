---
import { i } from '../data/i18n';
---
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a class="brand" href="#top">
          <img src="/polis2smartcity/polis2smartcity/polis2smartcity/polis2smartcity/images/logodefinitivo.png" alt="logo" width="50" height="50" style="margin-bottom:12px; object-fit:contain;" />
          <span {...i('Dalla Pólis alla Smart City', 'From Polis to Smart City')} style="display:block; font-family:var(--serif); font-size:1.1rem; color:#fff;">Dalla Pólis alla Smart City</span>
        </a>
        <p class="tag" {...i('Un plastico urbano rappresentativo di una porzione significativa della città di Brescia', 'A representative 3D scale model of Brescia.')}>Un plastico urbano rappresentativo di una porzione significativa della città di Brescia</p>
      </div>
      <div>
        <h4 {...i('Progetto', 'Project')}>Progetto</h4>
        <ul>
          <li><a href="#noi" {...i('La scuola', 'Our School')}>La scuola</a></li>
          <li><a href="#percorso" {...i('Il percorso', 'Roadmap')}>Il percorso</a></li>
          <li><a href="#gruppi" {...i('Teams', 'Teams')}>Teams</a></li>
        </ul>
      </div>
      <div>
        <h4 {...i('Approfondisci', 'Learn More')}>Approfondisci</h4>
        <ul>
          <li><a href="#galleria" {...i('Galleria', 'Gallery')}>Galleria</a></li>
          <li><a href="#confronto" {...i('Dashboard', 'Dashboard')}>Dashboard</a></li>
          <li><a href="#contatti" {...i('Contatti', 'Contacts')}>Contatti</a></li>
        </ul>
      </div>
      <div>
        <h4 {...i('Contatti', 'Contacts')}>Contatti</h4>
        <ul>
          <li><a href="mailto:info@dallapolisallasmartcity.it">info@dallapolisallasmartcity.it</a></li>
          <li><a href="#contatti" {...i('Scrivici', 'Write us')}>Scrivici</a></li>
          <li>
            <a href="https://www.instagram.com/polis2smartcity/">
              <img src="/polis2smartcity/polis2smartcity/polis2smartcity/polis2smartcity/images/Instagram_logo_2016.svg.webp" alt="Instagram" style="width:42px; height:42px; margin-top:8px;" />
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© 2026 Dalla Pólis alla Smart City. Tutti i diritti riservati.</span>
      <span class="swatches" aria-hidden="true">
        <span style="background:var(--azzurro)"></span><span style="background:var(--viola)"></span>
        <span style="background:var(--arancio)"></span><span style="background:var(--blu)"></span>
        <span style="background:var(--verde)"></span>
      </span>
    </div>
  </div>
</footer>